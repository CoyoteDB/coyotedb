{
  "name": "coyotedb-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "CoyoteDB web dashboard. Built into dist/ and embedded in the coyote binary.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "mock": "node mock/server.mjs --port 4330",
    "build": "tsc --noEmit -p . && node scripts/clean-dist.mjs && vite build && node scripts/size.mjs",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run e2e",
    "postinstall": "node scripts/go-ignore.mjs"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
