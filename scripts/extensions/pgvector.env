# pgvector release the extension archives are built from (D53). Changing
# it means rebuilding every archive and updating the sha256 pins in
# internal/pg/ext.go. The commit is checked after cloning the tag.
PGVECTOR_REPO=https://github.com/pgvector/pgvector.git
PGVECTOR_TAG=v0.8.7
PGVECTOR_VERSION=0.8.7
PGVECTOR_COMMIT=f37c13f68b57d2c3472b2214fbcff699d6d34876
